# Filled in at container start by the nginx image (only defined env vars, e.g. ${BACKEND_URL},
# are substituted; nginx's own $variables are left alone).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # ^~ : API paths never fall through to the static-file rules below.
    location ^~ /api/ {
        proxy_pass ${BACKEND_URL};
        # Document photos: the backend accepts up to 10 MB.
        client_max_body_size 12m;
        # OCR and face matching take a few seconds.
        proxy_read_timeout 120s;
        # The browser's host *with* its port, and no X-Forwarded-Proto: otherwise the backend
        # rebuilds its own address as port 80, sees the page's Origin (e.g. :4200) as another
        # site, and its CORS check refuses the request (403). Same origin end to end, no CORS.
        proxy_set_header Host $http_host;
        # The backend rate-limits logins per client IP: pass the real one, not nginx's.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Hashed bundles never change; index.html always must be fresh.
    location ~* \.(?:js|css|woff2?|png|jpg|svg|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Single-page app: unknown paths are Angular routes.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
